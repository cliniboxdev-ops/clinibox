{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clinibox",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "-p", "8123", "-c-1"],
      "port": 8123
    },
    {
      "name": "portal",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "pnpm", "--filter", "portal", "dev"],
      "port": 3100
    },
    {
      "name": "clinic",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "pnpm", "--filter", "clinic", "web"],
      "port": 8090
    }
  ]
}
